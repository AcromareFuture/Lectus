<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.heng.mapper.VPaymentRecordMapper">

    <resultMap id="BaseResultMap" type="com.heng.domain.VPaymentRecord">
            <id property="paymentId" column="payment_id" />
            <result property="orderId" column="order_id" />
            <result property="orderNo" column="order_no" />
            <result property="payType" column="pay_type" />
            <result property="outTradeNo" column="out_trade_no" />
            <result property="transactionId" column="transaction_id" />
            <result property="amountFen" column="amount_fen" />
            <result property="status" column="status" />
            <result property="callbackPayload" column="callback_payload" typeHandler="com.heng.support.JsonTypeHandler" />
            <result property="paidTime" column="paid_time" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        payment_id,order_id,order_no,pay_type,out_trade_no,transaction_id,
        amount_fen,status,callback_payload,paid_time,create_time,
        update_time
    </sql>
</mapper>
